#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
require 'json'
require 'open-uri'
require 'securerandom'
require 'tempfile'

EVENTS_PATH = File.expand_path("~/.config/pianobar/events")
LOG_PATH = File.expand_path("~/.config/pianobar/pianoctl.log")

# Log rotation configuration
MAX_LOG_SIZE = 5 * 1024 * 1024 # 5 MB
MAX_BACKUPS  = 3

def rotate_log_if_needed
  return unless File.exist?(LOG_PATH)
  return if File.size(LOG_PATH) < MAX_LOG_SIZE
  
  (MAX_BACKUPS - 1).downto(1) do |i|
    File.rename("#{LOG_PATH}.#{i}", "#{LOG_PATH}.#{i + 1}") if File.exist?("#{LOG_PATH}.#{i}")
  end
  File.rename(LOG_PATH, "#{LOG_PATH}.1")
rescue StandardError => e
  # Silently ignore to prevent TUI disruption or race conditions
end

def log(msg, level = :info)
  return unless msg.is_a?(String)
  
  timestamp = Time.now.strftime('%Y-%m-%d %H:%M:%S')
  line = "[#{timestamp}] [#{level.to_s.upcase}] pianobar-eventcmd: #{msg}\n"
  
  begin
    rotate_log_if_needed # Check & rotate before writing
    File.open(LOG_PATH, 'a') { |f| f.write(line) }
  rescue StandardError => e
    # Silently ignore logging errors to prevent crashing the event handler
  end
end

# @param kind [String]
# @param data [Hash]
def append_event(kind, **data)
  json_line = { **data, kind: }.to_json
  File.write(EVENTS_PATH, "#{json_line}\n", mode: 'a+')
  log("Appended event: #{kind}", :debug)
end

# @param name [String]
def do_fallible(name, &block)
  append_event("debug", msg: "Start #{name}")
  result = block.call
  append_event("debug", msg: "Finished #{name}")
  result
rescue StandardError => e
  append_event("error", while: name, e: e.message)
  exit(1)
end

EVENT_NAME = ARGV.pop.freeze

def ensure_events_path_is_present
  return if File.exist?(EVENTS_PATH) && File.ftype(EVENTS_PATH) == "file"

  if File.exist?(EVENTS_PATH)
    puts "#{EVENTS_PATH} exists, but is not a FIFO. Can you delete it and try again?"
    exit(1)
  end

  `touch "#{EVENTS_PATH}"`
end

log("pianobar-eventcmd is running", :info)
append_event("debug", msg: "pianobar-eventcmd initialized", event_name: EVENT_NAME)

# Read environment variables sent by pianobar
VALUES =
  do_fallible("reading input") do
    $stdin.set_encoding("UTF-8")
      .read
      .split("\n")
      .to_h { |line| (line.split('=') + [nil, nil]).slice(0, 2) }
      .freeze
  end

log("Received event: #{EVENT_NAME}", :info)
log("Values keys: #{VALUES.keys.join(', ')}", :debug)

case EVENT_NAME
when "songstart"
  cover_url = VALUES["coverArt"] || VALUES["COVERART"]
  
  unless cover_url
    append_event("error", reason: 'missing "coverArt" in VALUES')
    exit(1)
  end

  # Extract song/album info for debugging (pass all available metadata)
  song_info = VALUES.reject { |_, v| v.nil? || v.empty? }

  log("Song start detected. Info: #{song_info.inspect}", :info)

  # Download the cover art to a temp folder
  uri = do_fallible("parsing URL") { URI.parse(cover_url) }
  download_destination = "/tmp/pianobar-coverArt-#{SecureRandom.uuid_v7}"
  
  log("Downloading cover art to: #{download_destination}", :info)
  begin
    uri.open do |download|
      do_fallible("downloading image") do
        IO.copy_stream(download, download_destination)
      end
    end
    log("Cover art downloaded successfully.", :info)
    append_event("cover_art", **song_info, download_destination:)
  rescue StandardError => e
    log("Failed to download cover art: #{e.message}", :error)
    append_event("error", reason: "download_failed", details: e.message)
  end
end
