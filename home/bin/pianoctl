#!/usr/bin/env ruby
# frozen_string_literal: true

# Start pianobar as a daemon, and control it
#
# With this, the controlling terminal can be closed, and pianobar will
# continue.

require "io/console"
require "json"
require 'open3'

OUT_PATH = File.expand_path("~/.config/pianobar/out")
EVENTS_PATH = File.expand_path("~/.config/pianobar/events")
CONTROL_PATH = File.expand_path("~/.config/pianobar/ctl")

# Don't display what the user types
$stdin.echo = false

def pianobar_running?
  `pgrep pianobar` != ""
end

# @param cover_art_event [Hash]
def show_album_artwork(cover_art_event)
  return unless cover_art_event.is_a?(Hash)
  return unless cover_art_event.key?("download_destination")

  download_destination = cover_art_event["download_destination"]
  `kitten @ set-window-logo --self --position=top-right "#{download_destination}"`
end

def handle_events # rubocop:disable Metrics/MethodLength
  File.open(EVENTS_PATH) do |file|
    find_album_art_thread = nil
    loop do
      sleep(0.1)
      events = file.readlines.map do |line|
        JSON.parse(line)
      rescue StandardError
        { "kind" => "invalid_json", "original" => line }
      end

      # Handle only the most recent "cover_art" event
      cover_art_event = events
        .filter { |e| e.fetch("kind") == "cover_art" }
        .last

      next unless cover_art_event

      find_album_art_thread&.kill
      find_album_art_thread = Thread.new { show_album_artwork(cover_art_event) }
    end
  end
end

def display_output
  File.open(OUT_PATH) do |file|
    loop do
      sleep(0.1)
      content = file.read

      # Not raw -- that makes the output look funky
      $stdout.cooked { |io| io.print(content) }
    end
  end
end

def process_input
  File.open(CONTROL_PATH, "a") do |ctl|
    # Don't buffer `print`s to `ctl`
    ctl.sync = true

    loop do
      input = $stdin.getch
      input = "\n" if input == "\r"
      exit(0) if input == "\u0003" # CTRL-C

      ctl.print(input)
    end
  end
end

def ensure_pianobar_ctl_fifo_is_present
  return if File.exist?(CONTROL_PATH) && File.ftype(CONTROL_PATH) == "fifo"

  if File.exist?(CONTROL_PATH)
    puts "#{CONTROL_PATH} exists, but is not a FIFO. Can you delete it and try again?"
    exit(1)
  end

  File.mkfifo(CONTROL_PATH)
end

def ensure_pianobar_is_running
  return if pianobar_running?

  File.truncate(EVENTS_PATH, 0) if File.exist?(EVENTS_PATH)

  Process.fork do
    Process.daemon
    Dir.chdir(File.expand_path("~"))
    exec("pianobar > ~/.config/pianobar/out")
  end

  # Let pianobar get started before we try reading from `OUT_PATH` or writing
  # to `CONTROL_PATH`.
  sleep 0.1
end

def exit_when_pianobar_stops
  loop do
    sleep 1
    next if pianobar_running?

    File.truncate(EVENTS_PATH, 0)
    `kitten @ set-window-logo --self none`
    exit(0)
  end
end

begin
  ensure_pianobar_ctl_fifo_is_present

  ensure_pianobar_is_running

  Thread.new { handle_events }
  Thread.new { display_output }
  Thread.new { exit_when_pianobar_stops }
  process_input
rescue SystemExit, Interrupt, StandardError => e
  `kitten @ set-window-logo --self none`
  raise e
end
