#!/usr/bin/env ruby
# frozen_string_literal: true

# Start pianobar as a daemon, and control it
#
# With this, the controlling terminal can be closed, and pianobar will
# continue.

require "io/console"
require "json"
require 'open3'

OUT_PATH = File.expand_path("~/.config/pianobar/out")
EVENTS_PATH = File.expand_path("~/.config/pianobar/events")
CONTROL_PATH = File.expand_path("~/.config/pianobar/ctl")
LOG_PATH = File.expand_path("~/.config/pianobar/pianoctl.log")

# Log rotation configuration
MAX_LOG_SIZE = 5 * 1024 * 1024 # 5 MB
MAX_BACKUPS  = 3

def rotate_log_if_needed
  return unless File.exist?(LOG_PATH)
  return if File.size(LOG_PATH) < MAX_LOG_SIZE
  
  (MAX_BACKUPS - 1).downto(1) do |i|
    File.rename("#{LOG_PATH}.#{i}", "#{LOG_PATH}.#{i + 1}") if File.exist?("#{LOG_PATH}.#{i}")
  end
  File.rename(LOG_PATH, "#{LOG_PATH}.1")
rescue StandardError => e
  # Silently ignore to prevent TUI disruption or race conditions
end

# Thread-safe mutex for logging to prevent interleaved writes
LOG_MUTEX = Mutex.new

def log(msg, level = :info)
  return unless msg.is_a?(String)
  
  timestamp = Time.now.strftime('%Y-%m-%d %H:%M:%S')
  line = "[#{timestamp}] [#{level.to_s.upcase}] pianoctl: #{msg}\n"
  
  LOG_MUTEX.synchronize do
    rotate_log_if_needed # Check & rotate before writing
    begin
      File.open(LOG_PATH, 'a') { |f| f.write(line) }
    rescue StandardError => e
      # Silently ignore write errors
    end
  end
end

# Don't display what the user types
$stdin.echo = false

def pianobar_running?
  `pgrep pianobar` != ""
end

def show_album_artwork(cover_art_event)
  return unless cover_art_event.is_a?(Hash)
  return unless cover_art_event.key?("download_destination")

  download_destination = cover_art_event["download_destination"]
  log("Setting album artwork: #{download_destination}", :info)
  
  cmd_output = `kitten @ set-window-logo --self --position=top-right "#{download_destination}"`
  exit_status = $?.exitstatus
  log("kitten command output: #{cmd_output.strip}, exit status: #{exit_status}", :debug)
  
  if exit_status != 0
    log("Warning: kitten command failed with status #{exit_status}", :warn)
  end
end

def handle_events
  File.open(EVENTS_PATH) do |file|
    queue = Queue.new
    # Reader thread to fetch new events from the file
    Thread.new do
      loop do
        sleep(0.1)
        file.readlines.each { |line| queue << line }
      end
    end

    loop do
      line = queue.pop
      event = JSON.parse(line) rescue next
      next unless event["kind"] == "cover_art"

      log("Received cover_art event from pianobar", :info)
      log("Event details: #{event.inspect}", :debug)
      show_album_artwork(event)
    end
  end
end

def display_output
  File.open(OUT_PATH) do |file|
    loop do
      sleep(0.1)
      content = file.read

      # Not raw -- that makes the output look funky
      $stdout.cooked { |io| io.print(content) }
    end
  end
end

def process_input
  File.open(CONTROL_PATH, "a") do |ctl|
    # Don't buffer `print`s to `ctl`
    ctl.sync = true

    loop do
      input = $stdin.getch
      input = "\n" if input == "\r"
      exit(0) if input == "\u0003" # CTRL-C

      ctl.print(input)
    end
  end
end

def ensure_pianobar_ctl_fifo_is_present
  return if File.exist?(CONTROL_PATH) && File.ftype(CONTROL_PATH) == "fifo"

  if File.exist?(CONTROL_PATH)
    puts "#{CONTROL_PATH} exists, but is not a FIFO. Can you delete it and try again?"
    exit(1)
  end

  log("Creating control FIFO at #{CONTROL_PATH}", :info)
  File.mkfifo(CONTROL_PATH)
end

def ensure_pianobar_is_running
  return if pianobar_running?

  log("Pianobar is not running. Starting daemon...", :info)
  File.truncate(EVENTS_PATH, 0) if File.exist?(EVENTS_PATH)

  Process.fork do
    Process.daemon
    Dir.chdir(File.expand_path("~"))
    exec("pianobar > ~/.config/pianobar/out")
  end

  log("Pianobar daemon forked. Waiting for startup...", :info)
  sleep 0.1
end

def exit_when_pianobar_stops
  loop do
    sleep 1
    next if pianobar_running?

    log("Pianobar process not found. Clearing artwork.", :warn)
    File.truncate(EVENTS_PATH, 0)
    `kitten @ set-window-logo --self none`
    log("Artwork cleared successfully.", :info)
    exit(0)
  end
end

begin
  ensure_pianobar_ctl_fifo_is_present

  ensure_pianobar_is_running

  Thread.new { handle_events }
  Thread.new { display_output }
  Thread.new { exit_when_pianobar_stops }
  process_input
rescue SystemExit, Interrupt, StandardError => e
  log("Caught exception: #{e.class} - #{e.message}", :error)
  `kitten @ set-window-logo --self none`
  raise e
end
