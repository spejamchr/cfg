#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'fileutils'
require 'shellwords'
require 'io/wait'

# Flush log lines immediately (stdout is redirected to a file by launchd, which would
# otherwise fully buffer output and delay it until exit).
$stdout.sync = true

def log(msg)
  puts "#{Time.now} | #{msg}"
end

log "Beginning"

FISH_NO_PROMPT = "function fish_prompt; end;"
FISH_NO_CURSOR = "printf '\e[?25l';"
FISH_COMMAND = ->(display_name) {
  command = "sleep 0.2; while true; tbrs --display-name #{display_name.shellescape}; sleep 1; end"
  [
    "fish",
    "--init-command",
    "#{FISH_NO_PROMPT}; #{FISH_NO_CURSOR}; #{command}",
  ].freeze
}

STATIC_OPTIONS = [
  "--edge", "background",
  "-o", "modify_font=cell_height 180%",
  "-o", "window_margin_width=4",
  "-o", "placement_strategy=top",
  "-o", "modify_font=baseline 1",
  "-o", "font_size=11.0",
  # Extend to the physical edges of the screen, so it looks like a wallpaper
  "-o", "macos_use_physical_screen_frame=yes",
  "-o", "background_opacity=1",
  # Start with whichever picture is there at launch
  "-o", "background_image=~/Pictures/GeneratedWallpapers/*",
  "-o", "background_image_layout=cscaled",
  "-o", "default_pointer_shape=arrow",
  "-o", "pointer_shape_when_dragging=arrow"
].freeze

KITTY_BIN = `which kitty`.strip.freeze
raise "kitty not found in PATH: #{ENV.fetch('PATH', nil)}" unless File.exist?(KITTY_BIN)

SWIFT_BIN = `which swift`.strip.freeze

# Fallback poll interval, only used if the Swift display-change listener is unavailable.
POLL_INTERVAL_SECONDS = 2

# Display events often arrive in bursts (e.g. on wake); reconcile once after this quiet period.
DEBOUNCE_SECONDS = 1.0

# Registers CGDisplayRegisterReconfigurationCallback and prints a line to stdout each time
# macOS reports a display reconfiguration (connect, disconnect, mode/position change). This
# lets us react to hotplug events instead of polling `kitty +kitten panel --output-name=listjson`.
SWIFT_DISPLAY_LISTENER = <<~SWIFT
  import CoreGraphics
  import AppKit
  import Foundation

  func onReconfigure(_ display: CGDirectDisplayID, _ flags: CGDisplayChangeSummaryFlags, _ userInfo: UnsafeMutableRawPointer?) {
      print("changed")
      fflush(stdout)
  }

  // Plain command-line tools aren't connected to the window server by default, so
  // CGDisplayRegisterReconfigurationCallback silently never fires without this.
  _ = NSApplication.shared
  CGDisplayRegisterReconfigurationCallback(onReconfigure, nil)
  CFRunLoopRun()
SWIFT

# Spawns the Swift listener (fed via stdin, so no extra file is needed) and returns its IO,
# or nil if swift isn't available (caller should fall back to polling).
#
# @return [IO, nil]
def spawn_display_watcher
  return nil if SWIFT_BIN.empty?

  io = IO.popen([SWIFT_BIN, "-"], "r+")
  io.write(SWIFT_DISPLAY_LISTENER)
  io.close_write
  io
rescue StandardError => e
  log "ERROR: Failed to start display watcher: #{e.message}"
  nil
end

# @return [Array<String>] the macOS display names (e.g., "Built-in Retina Display")
def current_output_names
  JSON.parse(`#{KITTY_BIN} +kitten panel --output-name=listjson`)
    .map { |h| h.fetch("name") }
rescue JSON::ParserError => e
  log "ERROR: Failed to list outputs: #{e.message}"
  []
end

# @param name [String]
# @return [String]
def socket_path_for(name)
  # Use the display name as the socket identifier — safe because macOS display names
  # are consistent and we can safely slugify them for filesystem compatibility.
  safe_name = name.gsub(/[^a-zA-Z0-9_]/, '_')
  "/tmp/mykittywallboard_#{safe_name}"
end

# Spawns a kitty panel for the given display and returns its pid.
#
# @param name [String]
# @return [Integer]
def spawn_display(name)
  socket_path = socket_path_for(name)

  log "Handling display #{name} -> socket #{socket_path}"

  # Remove any stale socket before binding (avoids "address already in use" on restart)
  FileUtils.rm_f(socket_path)

  Process.spawn(
    KITTY_BIN, "+kitten", "panel",
    "--output-name=#{name}",
    "--listen-on=unix:#{socket_path}",
    *STATIC_OPTIONS,
    *FISH_COMMAND[name]
  )
end

# name => { pid:, thread: }
running = {}
running_mutex = Mutex.new

def stop_display(name, info)
  log "Display #{name} disconnected. Stopping panel (pid #{info[:pid]})..."
  begin
    Process.kill("TERM", info[:pid])
    Process.wait(info[:pid])
  rescue Errno::ESRCH, Errno::ECHILD
    # Already exited; nothing to do.
  end
  FileUtils.rm_f(socket_path_for(name))
end

def start_display(name, running, running_mutex)
  pid = spawn_display(name)
  thread = Thread.new do
    begin
      _, status = Process.wait2(pid)
      log "Panel for display #{name} (pid #{pid}) exited (#{status})."
    rescue Errno::ECHILD
      # Already reaped by stop_display's own Process.wait; nothing to do.
    end
    running_mutex.synchronize { running.delete(name) }
  end
  running_mutex.synchronize { running[name] = { pid: pid, thread: thread } }
end

# Wait for the kitty panels to be online
def wait_for_sockets(names, timeout: 4.0, interval: 0.02)
  deadline = Time.now + timeout
  until names.all? { |n| File.socket?(socket_path_for(n)) }
    break if Time.now > deadline

    sleep interval
  end
end

# Starts/stops panels so `running` matches whatever displays are currently connected.
def reconcile!(running, running_mutex)
  wanted = current_output_names
  current = running_mutex.synchronize { running.keys }

  (current - wanted).each do |name|
    info = running_mutex.synchronize { running.delete(name) }
    next unless info

    stop_display(name, info)
    info[:thread].kill
  end

  new_names = wanted - current
  new_names.each { |name| start_display(name, running, running_mutex) }

  wait_for_sockets(new_names)
  `tinty apply $(tinty current)`
end

shutting_down = false

['INT', 'TERM'].each do |sig|
  Signal.trap(sig) do
    shutting_down = true
  end
end

watcher_io = spawn_display_watcher
if watcher_io
  log "Watching for display changes via CoreGraphics listener"
else
  log "WARNING: swift not found; falling back to #{POLL_INTERVAL_SECONDS}s polling"
end

reconcile!(running, running_mutex) # Handle whatever's connected at startup

loop do
  if shutting_down
    log "Shutting down..."
    if watcher_io
      begin
        Process.kill("TERM", watcher_io.pid)
      rescue Errno::ESRCH
        # Already exited; nothing to do.
      end
      watcher_io.close
    end
    running_mutex.synchronize do
      running.each { |name, info| stop_display(name, info) }
      running.clear
    end
    exit
  end

  if watcher_io
    # Block here until the listener reports a change (or briefly times out, just so we
    # notice `shutting_down`) — no fixed-interval display polling.
    if watcher_io.wait_readable(1)
      line = watcher_io.gets
      if line.nil? # listener process died
        log "WARNING: display watcher exited; falling back to #{POLL_INTERVAL_SECONDS}s polling"
        watcher_io.close
        watcher_io = nil
      else
        # Debounce: wait until no more events arrive for DEBOUNCE_SECONDS.
        while watcher_io.wait_readable(DEBOUNCE_SECONDS)
          if watcher_io.gets.nil?
            watcher_io.close
            watcher_io = nil
            break
          end
        end
        reconcile!(running, running_mutex)
      end
    end
  else
    sleep POLL_INTERVAL_SECONDS
    reconcile!(running, running_mutex)
  end
end
