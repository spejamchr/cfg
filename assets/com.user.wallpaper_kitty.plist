<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.wallpaper_kitty</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>source $HOME/.zprofile ; source $HOME/.profile ; $HOME/.bin/wallpaper_kitty</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/wallpaper_kitty.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/wallpaper_kitty.err.log</string>
</dict>
</plist>
